	(text "Cell -> J1 -> R1 shunt (high side) -> J2 -> main board J2.  INA219 reads VBAT (IN- to GND) and the cell current both ways: +/-40 mV range = +/-182 mA, 45 uA per step."
		(exclude_from_sim no)
		(at 19.05 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3dda99e9-c852-5607-993e-7e457300cbfe")
	)
	(text "U2 is powered from U1 (SNS_PWR) only while sampling, so it draws nothing in between (its own power-down mode still takes about 6 uA).  Private bit-banged I2C (ISDA/ISCL) so the main bus never back-powers it."
		(exclude_from_sim no)
		(at 19.05 32.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6f382bd1-8f4f-53da-b69f-d25883b1a03c")
	)
	(text "Battery % = U1 coulomb count, corrected from the resting voltage at night (LiFePO4 OCV table)."
		(exclude_from_sim no)
		(at 19.05 35.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "168ece99-aff9-56ab-926a-94e509a9078c")
	)
